# =========================================================
#  .gitignore для дипломного ML-проекта (Python / PyTorch)
#  Правило: код и конфиги — в git; данные, веса, окружения — нет.
# =========================================================

# --- Данные (версионируются отдельно, не через git) ---------
# Вся папка data/ вне git: и исходник, и сгенерированные таблицы.
data/*
!data/.gitkeep
# крупные форматы данных где бы они ни лежали
*.xlsx
*.csv
*.tsv
*.parquet
*.feather
*.h5
*.hdf5
*.fasta
*.fa

# --- Эмбеддинги и обученные модели --------------------------
models/*
*.pt
*.pth
*.ckpt
*.onnx
*.pkl
*.joblib
*.npy
*.npz

# --- Результаты экспериментов -------------------------------
results/figures/*
results/metrics/*

# --- Логи трекеров экспериментов ----------------------------
wandb/
mlruns/
lightning_logs/
runs/
*.log

# --- Python -------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# --- Виртуальные окружения ----------------------------------
.venv/
venv/
env/
.conda/
.env

# --- IDE / редакторы ----------------------------------------
.vscode/
.idea/

# --- ОС -----------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# --- Не игнорировать заглушки пустых папок ------------------
!**/.gitkeep
